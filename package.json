{
  "name": "yurigana",
  "version": "0.5.9",
  "description": "Readings of Japanese kanji words in context, and which furigana a reader no longer needs",
  "license": "BSD-3-Clause AND CC-BY-SA-4.0",
  "repository": "github:blankiekun/yurigana",
  "type": "module",
  "main": "./js/index.js",
  "types": "./js/index.d.ts",
  "typesVersions": {
    "*": {
      "kanji-readings.json": [
        "yurigana/kanji-readings.json"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./js/index.d.ts",
      "default": "./js/index.js"
    },
    "./kanji-readings.json": "./yurigana/kanji-readings.json"
  },
  "files": [
    "js/index.js",
    "js/index.d.ts",
    "yurigana/kanji-readings.json",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test js/*.test.js"
  }
}
